# Copiar a .env.local (que ya está en .gitignore) y completar con los
# valores reales de tu proyecto de Supabase (Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer esta con el prefijo NEXT_PUBLIC_: ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# Token que vos elegís y configurás también del lado de Meta al armar la
# suscripción del webhook (Meta for Developers > Webhooks).
META_WEBHOOK_VERIFY_TOKEN=

# App ID e App Secret de "Jab CRM" en developers.facebook.com > Configuración
# de la app > Básica. NEXT_PUBLIC_META_APP_ID es público (va en la URL del
# login); META_APP_SECRET nunca debe llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=

# Clave que vos elegís y configurás también del lado de Google Ads al armar
# la entrega por webhook del formulario de cliente potencial.
GOOGLE_LEAD_WEBHOOK_KEY=
