# Copiar a .env.local (que ya está en .gitignore) y completar con los
# valores reales de tu proyecto de Supabase (Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer esta con el prefijo NEXT_PUBLIC_: ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# Token que vos elegís y configurás también del lado de Meta al armar la
# suscripción del webhook (Meta for Developers > Webhooks).
META_WEBHOOK_VERIFY_TOKEN=

# App ID e App Secret de "Jab CRM" en developers.facebook.com > Configuración
# de la app > Básica. NEXT_PUBLIC_META_APP_ID es público (va en la URL del
# login); META_APP_SECRET nunca debe llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=

# Clave que vos elegís y configurás también del lado de Google Ads al armar
# la entrega por webhook del formulario de cliente potencial.
GOOGLE_LEAD_WEBHOOK_KEY=

# API key de resend.com — se usa para mandar los mails de notificación
# (lead asignado, lead vencido, tarea vencida). Sin esta clave el sistema
# sigue funcionando normal, simplemente no manda mails.
RESEND_API_KEY=
# Remitente verificado en Resend. Necesita el dominio (jabmarketing.site)
# verificado en Resend > Domains con sus registros DNS.
RESEND_FROM_EMAIL="Jab CRM <notificaciones@jabmarketing.site>"

# Token secreto propio para autenticar el cron diario de notificaciones
# (Vercel Cron manda este valor en el header Authorization).
CRON_SECRET=

# API key de console.anthropic.com — habilita "Sugerir con IA" en Bandeja
# (redacta un borrador de respuesta de WhatsApp para que el vendedor lo
# revise y mande, nunca se envía solo). Sin esta clave el botón sigue
# apareciendo pero avisa que la IA no está configurada.
ANTHROPIC_API_KEY=
